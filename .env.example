# ---------------------------------------------------------------------------
# 4lo4lo — environment configuration
#
# Copy to .env and fill in. Never commit .env (it is gitignored).
# Every variable the code actually reads is listed here.
# ---------------------------------------------------------------------------

# --- Database (required) ---------------------------------------------------
# Single MySQL connection string used by the pooled client in lib/db.ts.
DATABASE_URL="mysql://user:password@host:3306/database"

# drizzle-kit (migrations/introspection) reads these separately from
# DATABASE_URL. Point them at the SAME database — a mismatch here means
# migrations get generated against a different schema than the app uses.
MYSQL_DB_HOST="localhost"
MYSQL_DB_USER="root"
MYSQL_DB_PASSWORD=""
MYSQL_DB_NAME="growsocial"


# --- Auth (required) -------------------------------------------------------
# Generate with:  openssl rand -base64 32
# SESSION_SECRET is the legacy name and is only a fallback; prefer NEXTAUTH_SECRET.
NEXTAUTH_SECRET=""
# Public origin of the deployment. Also used to build shortened-link URLs.
NEXTAUTH_URL="http://localhost:3000"

# Google sign-in is optional — the provider is only registered when BOTH are set.
GOOGLE_CLIENT_ID=""
GOOGLE_CLIENT_SECRET=""


# --- Email (required for password reset, welcome mail, support form) -------
# Without EMAIL_USER and EMAIL_PASSWORD, lib/core/services/mailer.ts throws
# rather than silently dropping mail.
EMAIL_HOST="smtp-relay.brevo.com"
EMAIL_PORT="587"
EMAIL_SECURE="false"
EMAIL_USER=""
EMAIL_PASSWORD=""
EMAIL_FROM='"4LO4LO - Social Growth Platform" <noreply@4lo4lo.site>'
# Where the /support contact form delivers. Defaults to EMAIL_USER if unset.
SUPPORT_INBOX=""
# Leave unset. Only set to "true" in local dev against a self-signed SMTP proxy;
# it disables TLS certificate verification.
# EMAIL_ALLOW_SELF_SIGNED="false"

# Optional: Brevo REST API key, if you use the API rather than SMTP.
BREVO_API_KEY=""


# --- Payments --------------------------------------------------------------
STRIPE_SECRET_KEY=""
# Exposed to the browser via next.config.ts. Publishable key only — never the
# secret key.
VITE_STRIPE_PUBLIC_KEY=""


# --- Firebase (push notifications) -----------------------------------------
VITE_FIREBASE_API_KEY=""
VITE_FIREBASE_APP_ID=""
VITE_FIREBASE_PROJECT_ID=""
VITE_FIREBASE_MESSAGING_SENDER_ID=""
