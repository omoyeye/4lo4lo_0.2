# ---------------------------------------------------------------------------
# 4lo4lo — environment configuration
#
# Copy to .env and fill in. Never commit .env (it is gitignored).
# Every variable the code actually reads is listed here.
# ---------------------------------------------------------------------------

# --- Database (required) ---------------------------------------------------
# Single MySQL connection string used by the pooled client in lib/db.ts.
DATABASE_URL="mysql://user:password@host:3306/database"

# Max MySQL connections PER serverless instance. Defaults to 2 on Vercel and
# 10 elsewhere. Vercel runs many concurrent instances and each keeps its own
# pool, so the real ceiling is roughly this number times the instance count —
# budget it against your host's max_connections. Raise only with evidence.
# DB_CONNECTION_LIMIT="2"

# drizzle-kit (migrations/introspection) reads these separately from
# DATABASE_URL. Point them at the SAME database — a mismatch here means
# migrations get generated against a different schema than the app uses.
MYSQL_DB_HOST="localhost"
MYSQL_DB_USER="root"
MYSQL_DB_PASSWORD=""
MYSQL_DB_NAME="growsocial"


# --- Auth (required) -------------------------------------------------------
# Generate with:  openssl rand -base64 32
# SESSION_SECRET is the legacy name and is only a fallback; prefer NEXTAUTH_SECRET.
NEXTAUTH_SECRET=""
# Public origin of the deployment. Also used to build shortened-link URLs.
NEXTAUTH_URL="http://localhost:3000"

# REQUIRED IN PRODUCTION. Canonical origin used for canonical tags, Open Graph
# URLs, robots.txt and sitemap.xml. If unset it falls back to NEXTAUTH_URL and
# then to localhost — canonical URLs pointing at a preview domain or localhost
# split your ranking signals and break link previews.
NEXT_PUBLIC_SITE_URL="https://4lo4lo.site"

# Google sign-in is currently DISABLED — the provider was removed from auth.ts.
# These are kept for reference; setting them has no effect until the provider
# is restored. See the comment in auth.ts.
# GOOGLE_CLIENT_ID=""
# GOOGLE_CLIENT_SECRET=""


# --- Email (required for password reset, welcome mail, support form) -------
# Without EMAIL_USER and EMAIL_PASSWORD, lib/core/services/mailer.ts throws
# rather than silently dropping mail.
EMAIL_HOST="smtp-relay.brevo.com"
EMAIL_PORT="587"
EMAIL_SECURE="false"
EMAIL_USER=""
EMAIL_PASSWORD=""
EMAIL_FROM='"4LO4LO - Social Growth Platform" <noreply@4lo4lo.site>'
# Where the /support contact form delivers. Defaults to EMAIL_USER if unset.
SUPPORT_INBOX=""
# Leave unset. Only set to "true" in local dev against a self-signed SMTP proxy;
# it disables TLS certificate verification.
# EMAIL_ALLOW_SELF_SIGNED="false"

# Optional: Brevo REST API key, if you use the API rather than SMTP.
BREVO_API_KEY=""


# --- Error monitoring -------------------------------------------------------
# Sentry is completely inert until a DSN is set: Sentry.init is never called,
# so this is safe to deploy before you have an account.
# Create a project at sentry.io, choose Next.js, and paste the DSN here.
NEXT_PUBLIC_SENTRY_DSN=""

# Optional, for readable stack traces. Source maps are only uploaded when all
# three are set; otherwise the build is unchanged.
SENTRY_ORG=""
SENTRY_PROJECT=""
SENTRY_AUTH_TOKEN=""


# --- Analytics -------------------------------------------------------------
# Google Tag Manager container. Defaults to GTM-NCTTLTKR if unset.
# Only loads in production builds, so local dev never pollutes your container.
# Set to an empty string in the Vercel preview environment to exclude previews.
NEXT_PUBLIC_GTM_ID="GTM-NCTTLTKR"


# --- Payments --------------------------------------------------------------
STRIPE_SECRET_KEY=""
# Exposed to the browser via next.config.ts. Publishable key only — never the
# secret key.
VITE_STRIPE_PUBLIC_KEY=""


# --- File storage ----------------------------------------------------------
# Set automatically when you connect a Blob store in the Vercel dashboard
# (Storage → Blob). Required for admin image upload in production: Vercel's
# filesystem is read-only, so writing to public/uploads fails there.
# Left unset locally, uploads fall back to public/uploads on disk.
BLOB_READ_WRITE_TOKEN=""


# --- Firebase -------------------------------------------------------------
# REMOVED. lib/firebase.ts was the only consumer, nothing imported it, and the
# firebase package has been uninstalled. Push notifications use the browser
# Notification API (hooks/use-push-notifications.ts), not Firebase.
# These variables can be deleted from the Vercel project settings.
